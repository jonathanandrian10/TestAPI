@page
@model ProductsPageModel
@{
    ViewData["Title"] = "Products";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="mb-4">Product Management</h2>

    <form method="post" class="row g-3">
        <div class="col-md-4">
            <input asp-for="NewProduct.Name" class="form-control" placeholder="Product Name" />
            <span class="text-danger" asp-validation-for="NewProduct.Name"></span>
        </div>
        <div class="col-md-4">
            <input asp-for="NewProduct.Description" class="form-control" placeholder="Description" />
            <span class="text-danger" asp-validation-for="NewProduct.Description"></span>
        </div>
        <div class="col-md-2">
            <input asp-for="NewProduct.Price" type="number" step="0.01" class="form-control" placeholder="Price" />
            <span class="text-danger" asp-validation-for="NewProduct.Price"></span>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Add Product</button>
        </div>
    </form>

    <hr class="my-4" />

    <h4>Product List</h4>
    <table class="table table-striped">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price ($)</th>
                <th>Date Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td>@product.Price</td>
                    <td>@product.Date.ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}