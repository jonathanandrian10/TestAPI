@page
@model ProductsPageModel
@{
    ViewData["Title"] = "Product Management";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <h2 class="mb-4">Product Management</h2>

    <form method="post" class="mb-4">
        <div class="row g-3">
            <div class="col-md-3">
                <input asp-for="NewProduct.Name" class="form-control" placeholder="Name" />
                <span asp-validation-for="NewProduct.Name" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <input asp-for="NewProduct.Description" class="form-control" placeholder="Description" />
                <span asp-validation-for="NewProduct.Description" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <input asp-for="NewProduct.Price" type="number" step="0.01" class="form-control" placeholder="Price" />
                <span asp-validation-for="NewProduct.Price" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Add Product</button>
            </div>
        </div>
    </form>

    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price ($)</th>
                <th>Date Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Products)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Description</td>
                    <td>@p.Price</td>
                    <td>@p.Date.ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}